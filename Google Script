function doGet(e) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const type = e.parameter.type;

    function getAllData() {
        const inventory = dataToObjects(getOrCreateSheet(ss, "Inventory", [["model", "grit", "condition", "qty"]]).getDataRange().getValues());
        const metaData = getOrCreateSheet(ss, "Metadata", [["Sales", "Customers"]]).getDataRange().getValues();
        // ดึงข้อมูล Logs พร้อม Remark ในคอลัมน์ J
        const logs = dataToObjects(getOrCreateSheet(ss, "Logs", [["id", "date", "direction", "typeLabel", "item", "sale", "cust", "qty", "status", "remark"]]).getDataRange().getValues());

        return {
            inventory: inventory,
            sales: metaData.slice(1).map(r => r[0]).filter(String),
            customers: metaData.slice(1).map(r => r[1]).filter(String),
            logs: logs.slice(-100)
        };
    }

    if (type === 'inventory') return makeJSON(dataToObjects(ss.getSheetByName("Inventory").getDataRange().getValues()));
    if (type === 'metadata') {
        const meta = ss.getSheetByName("Metadata").getDataRange().getValues();
        return makeJSON({ sales: meta.slice(1).map(r => r[0]).filter(String), customers: meta.slice(1).map(r => r[1]).filter(String) });
    }
    return makeJSON(getAllData());
}

function makeJSON(data) {
    return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const postData = JSON.parse(e.postData.contents);
    const action = postData.action;

    // 1. ระบบบันทึก Log ใหม่ (เดี่ยว/กลุ่ม)
    if (action === "addLog" || action === "addMultiLogs") {
        const logs = action === "addLog" ? [postData.data] : postData.data;
        const logSheet = ss.getSheetByName("Logs");
        const invSheet = ss.getSheetByName("Inventory");
        const metaSheet = ss.getSheetByName("Metadata");
        const invData = invSheet.getDataRange().getValues();

        if (logs.length > 0) {
            const custName = logs[0].cust;
            const metaValues = metaSheet.getDataRange().getValues();
            const currentCustomers = metaValues.slice(1).map(r => r[1]).filter(String);
            if (custName && !currentCustomers.includes(custName)) {
                metaSheet.getRange(metaSheet.getLastRow() + 1, 2).setValue(custName);
            }
        }

        const firstLog = logs[0];
        const emojiHeader = firstLog.direction === "IN" ? "📥" : (firstLog.typeLabel === "ส่งทดลองใช้งาน" ? "🧪" : "💰");
        let lineMsg = `${emojiHeader} *บันทึกรายการ${firstLog.direction === 'IN' ? 'รับเข้า' : 'จ่ายออก'}*\n━━━━━━━━━━━━━━━━━━\n📝 *ประเภท:* ${firstLog.typeLabel}\n👤 *เซลล์:* ${firstLog.sale}\n🏢 *ลูกค้า:* ${firstLog.cust}\n\n📦 *รายการสินค้า:*`;

        logs.forEach(log => {
            // 1. บันทึกแถวลงใน Sheet Logs (คอลัมน์ A-J)
            logSheet.appendRow([
                log.id,
                log.date,
                log.direction,
                log.typeLabel,
                log.item,
                log.sale,
                log.cust,
                log.qty,
                log.status,
                log.remark || ""
            ]);

            // 2. แยกรายการสินค้าเพื่อเตรียมตัดสต็อก
            const itemsToProcess = log.item.split(", ");

            itemsToProcess.forEach(itemEntry => {
                // Regex สำหรับแกะ: รุ่น, เบอร์, (สภาพ), xจำนวน 
                const match = itemEntry.match(/(.+) #(\d+)(?:\s*\((.*?)\))?(?:\s*x(\d+))?/);

                if (match) {
                    const modelName = match[1].trim();
                    const gritSize = match[2].trim();
                    // กำหนดสภาพสินค้า: ถ้าไม่มีระบุในวงเล็บ ให้ดูจากประเภทรายการ (Used/New) 
                    let condition = match[3] ? match[3].trim() : (log.typeLabel.includes("Used") ? "Used" : "New");

                    // ส่วนสำคัญ: ดึงจำนวนจาก x... หลังชื่อสินค้า ถ้าไม่มีให้ถือว่าเป็น 1 ก้อน 
                    const itemQty = match[4] ? Number(match[4]) : 1;

                    // 3. วนลูปหาแถวสินค้าในคลัง (Inventory) เพื่อปรับยอด 
                    for (let i = 1; i < invData.length; i++) {
                        if (invData[i][0].toString().trim() == modelName &&
                            invData[i][1].toString().trim() == gritSize &&
                            invData[i][2].toString().trim() == condition) {

                            let currentQty = Number(invData[i][3]);
                            // คำนวณสต็อกใหม่ตามทิศทาง IN (รับเข้า) หรือ OUT (จ่ายออก) 
                            let newQty = currentQty;
                                if (log.direction === "IN") {
                                    newQty = currentQty + itemQty;
                                } else if (log.direction === "OUT") {
                                    newQty = currentQty - itemQty;
                                }

                            // บันทึกลง Sheet และอัปเดต Array ในหน่วยความจำเพื่อใช้ในรอบถัดไป 
                            invSheet.getRange(i + 1, 4).setValue(newQty);
                            invData[i][3] = newQty;
                            break;
                        }
                    }
                }
            });

            // เพิ่มข้อมูลลงในข้อความแจ้งเตือน LINE 
            lineMsg += `\n   🔹 ${log.item}`;
        });

        if (firstLog.remark) {
            lineMsg += `\n\n📝 *หมายเหตุ:* ${firstLog.remark}`;
        }
        lineMsg += `\n━━━━━━━━━━━━━━━━━━\n✨ _RDS by C2TECH_`;
        sendLineNotification(lineMsg);

        // 2. ปิดการขายสินค้าทดลอง
    } else if (action === "confirmTestToSale") {
        const logSheet = ss.getSheetByName("Logs");
        const logData = logSheet.getDataRange().getValues();
        const targetId = postData.id;
        for (let i = 1; i < logData.length; i++) {
            if (logData[i][0].toString() === targetId.toString()) {
                logSheet.getRange(i + 1, 4).setValue("ขายสินค้า");
                logSheet.getRange(i + 1, 9).setValue("COMPLETED");
                const closedMsg = `💰 *ปิดการขายเรียบร้อย!*\n━━━━━━━━━━━━━━━━━━\n🏢 *ลูกค้า:* ${logData[i][6]}\n👤 *เซลล์:* ${logData[i][5]}\n\n📦 *รายการ:*\n   🔹 ${logData[i][4].split(', ').join('\n   🔹 ')}\n\n✅ *สถานะ:* COMPLETED\n━━━━━━━━━━━━━━━━━━\n✨ _RDS by C2TECH_`;
                sendLineNotification(closedMsg);
                break;
            }
        }

        // 3. รับคืนสินค้าทดลอง
    } else if (action === "returnTestItem") {
        const logSheet = ss.getSheetByName("Logs");
        const invSheet = ss.getSheetByName("Inventory");
        const logData = logSheet.getDataRange().getValues();
        const invData = invSheet.getDataRange().getValues();
        const targetId = postData.id;
        for (let i = 1; i < logData.length; i++) {
            if (logData[i][0].toString() === targetId.toString()) {
                logSheet.getRange(i + 1, 9).setValue("RETURNED");
                const itemsToReturn = logData[i][4].split(", ");
                itemsToReturn.forEach(itemEntry => {
                    const match = itemEntry.match(/(.+) #(\d+)(?:\s*\((.*?)\))?(?:\s*x(\d+))?/);
                    if (match) {
                        const m = match[1].trim(), g = match[2].trim(), condition = "Used";
                        const q = match[4] ? Number(match[4]) : Number(logData[i][7]);
                        for (let j = 1; j < invData.length; j++) {
                            if (invData[j][0].toString().trim() == m && invData[j][1].toString().trim() == g && invData[j][2].toString().trim() == condition) {
                                let currentStock = Number(invData[j][3]);
                                invSheet.getRange(j + 1, 4).setValue(currentStock + q);
                                invData[j][3] = currentStock + q;
                                break;
                            }
                        }
                    }
                });
                const returnMsg = `🔄 *รับคืนสินค้า (ทดลอง)*\n━━━━━━━━━━━━━━━━━━\n🏢 *ลูกค้า:* ${logData[i][6]}\n👤 *เซลล์:* ${logData[i][5]}\n\n📦 *รายการ:* ${logData[i][4]}\n\n✅ *สถานะ:* คืนเข้าคลัง (Used) เรียบร้อย`;
                sendLineNotification(returnMsg);
                break;
            }
        }

        // 4. ยกเลิกรายการผิดพลาด (แก้ไขให้รองรับหลายรายการในการ์ดเดียว)
    } else if (action === "cancelLog") {
        const logSheet = ss.getSheetByName("Logs");
        const invSheet = ss.getSheetByName("Inventory");
        const logData = logSheet.getDataRange().getValues();
        const invData = invSheet.getDataRange().getValues();
        const targetId = postData.id;

        for (let i = 1; i < logData.length; i++) {
            if (logData[i][0].toString() === targetId.toString()) {
                const direction = logData[i][2]; // IN หรือ OUT
                const itemStr = logData[i][4];   // เช่น "หิน A #600 (New) x2, หิน B #800 (New) x1"

                // --- ส่วนที่แก้ไข: แยกรายการสินค้าออกมาเป็น Array ---
                const itemsToCancel = itemStr.split(", ");

                itemsToCancel.forEach(itemEntry => {
                    const match = itemEntry.match(/(.+) #(\d+)(?:\s*\((.*?)\))?(?:\s*x(\d+))?/);
                    if (match) {
                        const m = match[1].trim(); // ชื่อรุ่น
                        const g = match[2].trim(); // เบอร์ (Grit)
                        const cond = match[3] ? match[3].trim() : "New"; // สภาพ
                        const q = match[4] ? Number(match[4]) : 1; // จำนวน (ถ้าไม่มี x ให้เป็น 1)

                        // ค้นหาใน Inventory เพื่อคืนค่า
                        for (let j = 1; j < invData.length; j++) {
                            if (invData[j][0].toString().trim() == m &&
                                invData[j][1].toString().trim() == g &&
                                invData[j][2].toString().trim() == cond) {

                                let currentQty = Number(invData[j][3]);
                                // ถ้าเดิมเป็น OUT (ขาย/ทดลอง) ยกเลิกต้อง + คืน
                                // ถ้าเดิมเป็น IN (รับเข้า) ยกเลิกต้อง - ออก
                                let newQty = direction === "OUT" ? currentQty + q : currentQty - q;

                                invSheet.getRange(j + 1, 4).setValue(newQty);
                                invData[j][3] = newQty; // อัปเดตค่าใน Array เพื่อความถูกต้องหากมีรายการซ้ำ
                                break;
                            }
                        }
                    }
                });
                // ----------------------------------------------

                logSheet.deleteRow(i + 1);
                sendLineNotification(`🚫 *ยกเลิกรายการผิดพลาด*\n━━━━━━━━━━━━━━━━━━\n🏢 *ลูกค้า:* ${logData[i][6]}\n📦 *รายการ:* ${itemStr}\n✅ *สถานะ:* คืนสต็อกทุกรายการเรียบร้อย`);
                break;
            }
        }

        // 5. จัดการ Metadata (Sale/Customer) 
    } else if (action === "addData") {
        const metaSheet = ss.getSheetByName("Metadata");
        const col = postData.type === 'SALE' ? 1 : 2;
        metaSheet.getRange(metaSheet.getLastRow() + 1, col).setValue(postData.name);
    } else if (action === "deleteData") {
        const metaSheet = ss.getSheetByName("Metadata");
        const col = postData.type === 'SALE' ? 0 : 1;
        const data = metaSheet.getDataRange().getValues();
        for (let i = 1; i < data.length; i++) {
            if (data[i][col] === postData.name) {
                metaSheet.getRange(i + 1, col + 1).clearContent();
                break;
            }
        }

        // 6. จัดการข้อมูลสินค้า (Model/Grit) 
    } else if (action === "deleteModel") {
        const invSheet = ss.getSheetByName("Inventory");
        const invData = invSheet.getDataRange().getValues();
        const modelToDelete = postData.model;
        const gritToDelete = postData.grit;
        for (let i = invData.length - 1; i >= 1; i--) {
            if (invData[i][0].toString() === modelToDelete.toString() && invData[i][1].toString() === gritToDelete.toString()) {
                invSheet.deleteRow(i + 1);
            }
        }
    } else if (action === "addModel") {
        const invSheet = ss.getSheetByName("Inventory");
        invSheet.appendRow([postData.model, postData.grit, "New", 0]);
        invSheet.appendRow([postData.model, postData.grit, "Used", 0]);

        // 7. ฟีเจอร์ใหม่: แก้ไข Remark (เฉพาะ Admin) 
    } else if (action === "editRemark") {
        const logSheet = ss.getSheetByName("Logs");
        const logData = logSheet.getDataRange().getValues();
        const targetId = postData.id;
        const newRemark = postData.remark;

        for (let i = 1; i < logData.length; i++) {
            if (logData[i][0].toString() === targetId.toString()) {
                logSheet.getRange(i + 1, 10).setValue(newRemark); // อัปเดต Column J (คอลัมน์ที่ 10) 
                break;
            }
        }
    // ... โค้ดส่วนบนของ doPost (ที่เช็ค action อื่นๆ) ...

    } else if (action === "processStockClaim") {
        const logSheet = ss.getSheetByName("Logs");
        const logData = logSheet.getDataRange().getValues();
        const invSheet = ss.getSheetByName("Inventory");
        const invData = invSheet.getDataRange().getValues();
        
        const targetId = postData.id; 
        const items = postData.item.split(', ');

        // 1. ตรวจสอบสต็อกว่ามีของพอให้ตัดเคลมหรือไม่
        let stockError = false;
        for (let itemStr of items) {
            const match = itemStr.match(/(.+) #(\d+)(?:\s*\((.*?)\))?(?:\s*x(\d+))?/);
            if (match) {
                const modelName = match[1].trim();
                const gritSize = match[2].trim();
                let condition = match[3] ? match[3].trim() : "New";
                const deductQty = match[4] ? Number(match[4]) : 1;
                
                for (let j = 1; j < invData.length; j++) {
                    if (invData[j][0].toString().trim() == modelName && 
                        invData[j][1].toString().trim() == gritSize && 
                        invData[j][2].toString().trim() == condition) {
                        if (Number(invData[j][3] || 0) < deductQty) {
                            stockError = true;
                        }
                        break;
                    }
                }
            }
        }

        // ถ้ายอดไม่พอ ให้ส่ง Error กลับไปหาหน้าเว็บ
        if (stockError) {
            return ContentService.createTextOutput(JSON.stringify({status: "error", message: "สินค้าคงเหลือไม่พอ"})).setMimeType(ContentService.MimeType.JSON);
        }

        // 2. ถ้าของพอ ค่อยตัดสต็อกจริง
        items.forEach(itemStr => {
            const match = itemStr.match(/(.+) #(\d+)(?:\s*\((.*?)\))?(?:\s*x(\d+))?/);
            if (match) {
                const modelName = match[1].trim();
                const gritSize = match[2].trim();
                let condition = match[3] ? match[3].trim() : "New";
                const deductQty = match[4] ? Number(match[4]) : 1;
                for (let j = 1; j < invData.length; j++) {
                    if (invData[j][0].toString().trim() == modelName && 
                        invData[j][1].toString().trim() == gritSize && 
                        invData[j][2].toString().trim() == condition) {
                        invSheet.getRange(j + 1, 4).setValue(Number(invData[j][3] || 0) - deductQty);
                        break;
                    }
                }
            }
        });

        // 3. เปลี่ยนสถานะ Log ให้เป็น CLAIMED
        for (let i = 1; i < logData.length; i++) {
            if (logData[i][0].toString() === targetId.toString()) {
                logSheet.getRange(i + 1, 9).setValue("CLAIMED");
                break;
            }
        }
        
        // 4. บันทึก Log ใหม่แบบย้อนหลัง
        const newId = "L" + new Date().getTime();
        const ts = Utilities.formatDate(new Date(), "Asia/Bangkok", "HH:mm dd/MM/yyyy");
        const yearParts = ts.split('/');
        const thYear = parseInt(yearParts[2]) + 543;
        const thDate = ts.substring(0, 11) + thYear;
        
        logSheet.appendRow([
            newId,
            thDate,
            "OUT",
            "เคลมสินค้า (ปิดงานย้อนหลัง)",
            postData.item,
            postData.sale,
            postData.cust,
            postData.qty,
            "CLAIMED",
            "ตัดสต็อกเคลมย้อนหลัง (มีของเข้าคลังแล้ว)"
        ]);
        
        return ContentService.createTextOutput(JSON.stringify({status: "success"})).setMimeType(ContentService.MimeType.JSON);
    }else {
        // 1. ถ้าไม่รู้จัก Action จริงๆ ให้คืนค่า Error
        return ContentService.createTextOutput(JSON.stringify({status: "error", message: "Action not found: " + action })).setMimeType(ContentService.MimeType.JSON);
    }

    // 🚨 2. พระเอกของเราอยู่ตรงนี้: ส่งค่า Success คืนให้ฟังก์ชันเก่าทั้งหมด (addLog, addMultiLogs ฯลฯ) 
    return ContentService.createTextOutput(JSON.stringify({status: "success"})).setMimeType(ContentService.MimeType.JSON);
}

function getOrCreateSheet(ss, name, headers) {
    let s = ss.getSheetByName(name);
    if (!s) { s = ss.insertSheet(name); s.getRange(1, 1, 1, headers[0].length).setValues(headers); }
    return s;
}

function dataToObjects(values) {
    if (values.length < 2) return [];
    const headers = values[0];
    return values.slice(1).map(row => {
        const obj = {};
        headers.forEach((h, i) => obj[h] = row[i]);
        return obj;
    });
}

function sendLineNotification(message) {
    const url = "https://api.line.me/v2/bot/message/push";
    try { UrlFetchApp.fetch(url, { "method": "post", "headers": { "Content-Type": "application/json", "Authorization": "Bearer " + LINE_TOKEN }, "payload": JSON.stringify({ "to": TARGET_ID, "messages": [{ "type": "text", "text": message }] }) }); } catch (e) { }
}
const VERSION = "2.3.0";
const TZ = "Asia/Bangkok";
const DEFAULT_MIN_STOCK = 10;          // เกณฑ์ "ใกล้หมด" เริ่มต้น (นับเฉพาะ New) — Admin แก้รายรุ่นได้
const ADMIN_TOKEN_HOURS = 8;
const RECENT_LOGS = 300;               // จำนวนประวัติล่าสุดที่ส่งให้หน้าเว็บ (ตัวเลขสรุปคำนวณจากทุกแถวเสมอ)

const INV_HEADERS = ["model", "grit", "condition", "qty", "minStock"];
const LOG_HEADERS = ["id", "date", "direction", "typeLabel", "item", "sale", "cust", "qty", "status", "remark",
    "createdAt", "closedAt", "cancelledAt", "cancelReason"];
const META_HEADERS = ["Sales", "Customers"];
const C = { id: 0, date: 1, direction: 2, typeLabel: 3, item: 4, sale: 5, cust: 6, qty: 7, status: 8, remark: 9,
    createdAt: 10, closedAt: 11, cancelledAt: 12, cancelReason: 13 };

const TYPE_SALE = "ขายสินค้า";
const TYPE_TRIAL = "ส่งทดลองใช้งาน";
const TYPE_CLAIM = "เคลมสินค้า";
const TYPE_CLAIM_LEGACY_DUP = "เคลมสินค้า (ปิดงานย้อนหลัง)"; // แถวซ้ำที่ระบบเวอร์ชันก่อนสร้างไว้ — ไม่นับยอด

// คำสั่งที่ต้องเป็น Admin (ตรวจ token ที่ฝั่ง Server ทุกครั้ง ไม่เชื่อหน้าเว็บ)
const ADMIN_ACTIONS = ["cancelLog", "editRemark", "deleteModel", "addModel", "addData", "deleteData", "setMinStock"];

// ======================================================================
// GET — โหลดข้อมูล
// ======================================================================
function doGet(e) {
    try {
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        const type = e && e.parameter ? e.parameter.type : "";
        const sheets = prepareSheets(ss);

        if (type === "customer") {
            const name = String(e.parameter.name || "").trim();
            const rows = readLogRows(sheets.logs).filter(r => String(r.cust).trim() === name);
            return makeJSON({ status: "success", customer: name, logs: rows.map(logRowToObject) });
        }
        if (type === "model") {
            // ประวัติของรุ่นหนึ่ง (ทุกสภาพ) — ใช้ตอนกดการ์ดในหน้าคลัง
            const model = String(e.parameter.model || "").trim(), grit = String(e.parameter.grit || "").trim();
            const rows = readLogRows(sheets.logs).filter(r => parseItems(r.item, r.typeLabel).some(it => it.model === model && it.grit === grit));
            return makeJSON({ status: "success", model: model, grit: grit, logs: rows.map(logRowToObject) });
        }

        const inventory = readInventory(sheets.inv);
        const meta = sheets.meta.getDataRange().getValues().slice(1);
        const logRows = readLogRows(sheets.logs);
        return makeJSON({
            version: VERSION,
            inventory: inventory.map(r => ({ model: r.model, grit: r.grit, condition: r.condition, qty: r.qty, minStock: r.minStock })),
            sales: meta.map(r => r[0]).filter(String),
            customers: meta.map(r => r[1]).filter(String),
            logs: logRows.slice(-RECENT_LOGS).map(logRowToObject),
            totalLogs: logRows.length,
            summary: buildSummary(logRows, inventory, new Date())
        });
    } catch (err) {
        return makeJSON({ status: "error", message: "เกิดข้อผิดพลาดที่เซิร์ฟเวอร์ (doGet): " + err.message });
    }
}

function makeJSON(data) {
    return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);
}
function ok(extra) { return makeJSON(Object.assign({ status: "success" }, extra || {})); }
function fail(message, extra) { return makeJSON(Object.assign({ status: "error", message: message }, extra || {})); }

// ======================================================================
// POST — คำสั่งทั้งหมด
// ======================================================================
function doPost(e) {
    try {
        if (!e || !e.postData || !e.postData.contents) return fail("ไม่พบข้อมูลที่ส่งมา กรุณาลองใหม่อีกครั้ง");
        const postData = JSON.parse(e.postData.contents);
        const action = postData.action;

        if (action === "adminLogin") return adminLogin(postData.password);

        if (ADMIN_ACTIONS.indexOf(action) !== -1 && !verifyAdminToken(postData.token)) {
            return fail("สิทธิ์ Admin หมดอายุ กรุณาเข้าสู่ระบบ Admin ใหม่", { code: "unauthorized" });
        }

        // 🔒 กัน 2 คนบันทึกพร้อมกันแล้วตัดสต็อกชนกัน
        const lock = LockService.getScriptLock();
        try { lock.waitLock(30000); }
        catch (lockErr) { return fail("ระบบมีผู้ใช้งานพร้อมกันหลายคน กรุณารอสักครู่แล้วลองใหม่อีกครั้ง"); }

        let pendingLine = null;
        try {
            const ss = SpreadsheetApp.getActiveSpreadsheet();
            const result = handleAction(ss, prepareSheets(ss), action, postData);
            pendingLine = result.line || null;
            return makeJSON(result.body);
        } catch (err) {
            return fail(err.message);
        } finally {
            SpreadsheetApp.flush();
            lock.releaseLock();
            // ส่ง LINE หลังปล่อย Lock แล้ว — ไม่ให้คนถัดไปต้องรอ LINE ตอบ
            if (pendingLine) sendLineNotification(pendingLine);
        }
    } catch (outerErr) {
        return fail("เกิดข้อผิดพลาดที่เซิร์ฟเวอร์: " + outerErr.message);
    }
}

function handleAction(ss, sh, action, p) {
    switch (action) {
        case "addLog":
        case "addMultiLogs": return addLogs(sh, action === "addLog" ? [p.data] : p.data);
        case "confirmTestToSale": return confirmTestToSale(sh, p.id);
        case "returnTestItem": return returnTestItem(sh, p.id);
        case "closeClaim": return closeClaim(sh, p.id);
        case "processStockClaim": return processStockClaim(sh, p.id);
        case "cancelLog": return cancelLog(sh, p.id, p.reason);
        case "editRemark": return editRemark(sh, p.id, p.remark);
        case "addData": return addMeta(sh, p.type, p.name);
        case "deleteData": return deleteMeta(sh, p.type, p.name);
        case "addModel": return addModel(sh, p.model, p.grit);
        case "deleteModel": return deleteModel(sh, p.model, p.grit);
        case "setMinStock": return setMinStock(sh, p.model, p.grit, p.minStock);
        default: return { body: { status: "error", message: "Action not found: " + action } };
    }
}

// ----------------------------------------------------------------------
// 1) บันทึกรายการใหม่ (รับเข้า / ขาย / ส่งทดลอง / เคลม)
// ----------------------------------------------------------------------
function addLogs(sh, logs) {
    if (!Array.isArray(logs) || !logs.length) throw new Error("ไม่พบรายการที่จะบันทึก");
    const inv = readInventory(sh.inv);
    const now = new Date();

    // ตรวจทุกอย่างก่อน แล้วค่อยเขียน (ถ้าไม่ผ่านจะไม่บันทึกอะไรเลยสักแถว)
    const prepared = logs.map((log, i) => {
        const items = parseItems(log.item, log.typeLabel);
        if (!items.length) throw new Error("รูปแบบรายการสินค้าไม่ถูกต้อง: " + log.item);
        items.forEach(it => { if (!findInv(inv, it)) throw new Error("ไม่พบ " + itemLabel(it) + " ในคลัง (อาจถูกลบไปแล้ว) กรุณารีเฟรชแล้วลองใหม่"); });
        const direction = ["IN", "OUT", "NONE"].indexOf(log.direction) !== -1 ? log.direction : "OUT";
        return { log, items, direction, id: "L" + (now.getTime() + i) };
    });

    // ตรวจสต็อกพอไหมจากชีตจริง (ไม่เชื่อตัวเลขบนหน้าเว็บที่อาจเก่าแล้ว)
    const need = {};
    prepared.filter(x => x.direction === "OUT").forEach(x => x.items.forEach(it => {
        const k = invKey(it); need[k] = (need[k] || 0) + it.qty;
    }));
    const short = Object.keys(need).map(k => {
        const row = inv.find(r => invKey(r) === k);
        return row && row.qty < need[k] ? `${row.model} #${row.grit} ${row.condition} (เหลือ ${row.qty} ต้องการ ${need[k]})` : null;
    }).filter(Boolean);
    if (short.length) throw new Error("สต็อกไม่พอ: " + short.join(", ") + " — กรุณารีเฟรชดูยอดล่าสุด");

    const custName = String(prepared[0].log.cust || "").trim();
    if (custName) addCustomerIfNew(sh.meta, custName);

    const touched = [];
    prepared.forEach(x => {
        const log = x.log;
        // สถานะกำหนดที่ Server (ไม่เชื่อค่าที่หน้าเว็บส่งมา)
        const status = log.typeLabel === TYPE_TRIAL ? "PENDING"
            : log.typeLabel === TYPE_CLAIM ? (x.direction === "NONE" ? "WAITING_STOCK" : "WAITING_CLAIM")
            : "COMPLETED";
        const closedAt = status === "COMPLETED" ? now : "";
        sh.logs.appendRow([x.id, thaiStamp(now), x.direction, log.typeLabel, log.item, log.sale, log.cust,
            sumQty(x.items), status, log.remark || "", now, closedAt, "", ""]);
        if (x.direction === "IN" || x.direction === "OUT") {
            x.items.forEach(it => { adjustStock(sh.inv, inv, it, x.direction === "IN" ? it.qty : -it.qty); touched.push(invKey(it)); });
        }
    });

    const first = prepared[0];
    return { body: { status: "success", ids: prepared.map(x => x.id) }, line: msgNewLog(first, prepared, inv, touched, now) };
}

// ----------------------------------------------------------------------
// 2) ทดลอง → ปิดเป็นขาย (สต็อกตัดไปแล้วตอนส่งทดลอง)
// ----------------------------------------------------------------------
function confirmTestToSale(sh, id) {
    const r = findLog(sh.logs, id);
    if (r.status !== "PENDING") throw new Error("รายการนี้ไม่ได้อยู่ในสถานะทดลองแล้ว กรุณารีเฟรช");
    const now = new Date();
    setLogCells(sh.logs, r, { typeLabel: TYPE_SALE, status: "COMPLETED", closedAt: now });
    const days = daysBetween(rowDate(r), now);
    return { body: { status: "success" }, line: [
        "💰 ปิดการขาย (จากทดลอง) · " + r.qty + " ก้อน", LINE_RULE,
        "ลูกค้า : " + r.cust, "เซลล์ : " + (r.sale || "-"),
        "ทดลองไป : " + (days === null ? "-" : days + " วัน"), "",
        "รายการ", ...bulletItems(parseItems(r.item, r.typeLabel)),
        LINE_RULE, "อ้างอิง " + r.id].join("\n") };
}

// ----------------------------------------------------------------------
// 3) ทดลอง → รับคืน (กลับเข้าคลังเป็น Used)
// ----------------------------------------------------------------------
function returnTestItem(sh, id) {
    const r = findLog(sh.logs, id);
    if (r.status !== "PENDING") throw new Error("รายการนี้ไม่ได้อยู่ในสถานะทดลองแล้ว กรุณารีเฟรช");
    const inv = readInventory(sh.inv);
    const items = parseItems(r.item, r.typeLabel).map(it => Object.assign({}, it, { condition: "Used" }));
    const touched = [];
    items.forEach(it => {
        if (!findInv(inv, it)) throw new Error("ไม่พบ " + itemLabel(it) + " ในคลัง");
    });
    items.forEach(it => { adjustStock(sh.inv, inv, it, it.qty); touched.push(invKey(it)); });
    setLogCells(sh.logs, r, { status: "RETURNED", closedAt: new Date() });
    return { body: { status: "success" }, line: [
        "🔄 รับคืนของทดลอง · " + r.qty + " ก้อน", LINE_RULE,
        "ลูกค้า : " + r.cust, "เซลล์ : " + (r.sale || "-"), "",
        "เข้าคลังเป็น Used", ...bulletItems(items), "",
        "คงเหลือหลังรับคืน", ...stockLines(inv, touched),
        LINE_RULE, "อ้างอิง " + r.id].join("\n") };
}

// ----------------------------------------------------------------------
// 4) ปิดงานเคลม — หินเสียที่ลูกค้าส่งคืน "ไม่นับเข้าสต็อก" (ตามกติกาที่ตกลง)
// ----------------------------------------------------------------------
function closeClaim(sh, id) {
    const r = findLog(sh.logs, id);
    if (r.status !== "WAITING_CLAIM") throw new Error("รายการนี้ไม่ได้อยู่ในสถานะรอปิดงานเคลม กรุณารีเฟรช");
    setLogCells(sh.logs, r, { status: "CLAIMED", closedAt: new Date() });
    return { body: { status: "success" }, line: [
        "🛡️ ปิดงานเคลม", LINE_RULE,
        "ลูกค้า : " + r.cust, "เซลล์ : " + (r.sale || "-"), "",
        "รายการที่เปลี่ยนให้ลูกค้า", ...bulletItems(parseItems(r.item, r.typeLabel)), "",
        "หินเสียที่รับคืน ไม่นับเข้าสต็อก",
        LINE_RULE, "อ้างอิง " + r.id].join("\n") };
}

// ----------------------------------------------------------------------
// 5) เคลมที่รอของเข้า → ของเข้าแล้ว ตัดสต็อกและปิดงาน (อัปเดตแถวเดิม ไม่สร้างแถวซ้ำ)
// ----------------------------------------------------------------------
function processStockClaim(sh, id) {
    const r = findLog(sh.logs, id);
    if (r.status !== "WAITING_STOCK") throw new Error("รายการนี้ไม่ได้อยู่ในสถานะรอของเข้า กรุณารีเฟรช");
    const inv = readInventory(sh.inv);
    const items = parseItems(r.item, r.typeLabel);
    const short = items.map(it => {
        const row = findInv(inv, it);
        if (!row) return itemLabel(it) + " (ไม่พบในคลัง)";
        return row.qty < it.qty ? `${itemLabel(it)} (เหลือ ${row.qty})` : null;
    }).filter(Boolean);
    if (short.length) return { body: { status: "error", message: "สินค้าคงเหลือไม่พอ: " + short.join(", ") } };

    const touched = [];
    items.forEach(it => { adjustStock(sh.inv, inv, it, -it.qty); touched.push(invKey(it)); });
    const now = new Date();
    setLogCells(sh.logs, r, { direction: "OUT", status: "CLAIMED", closedAt: now,
        remark: [r.remark, "ตัดสต็อกเคลม " + thaiStamp(now)].filter(String).join(" · ") });
    return { body: { status: "success" }, line: [
        "🛡️ เคลม · ของเข้าแล้ว ตัดสต็อกและปิดงาน", LINE_RULE,
        "ลูกค้า : " + r.cust, "เซลล์ : " + (r.sale || "-"), "",
        "รายการ", ...bulletItems(items), "",
        "คงเหลือหลังตัด", ...stockLines(inv, touched),
        LINE_RULE, "อ้างอิง " + r.id].join("\n") };
}

// ----------------------------------------------------------------------
// 6) ยกเลิกรายการ (Admin) — ไม่ลบแถวแล้ว เปลี่ยนเป็น CANCELLED และคืนสต็อกตามสถานะจริง
// ----------------------------------------------------------------------
function cancelLog(sh, id, reason) {
    const r = findLog(sh.logs, id);
    if (r.status === "CANCELLED") throw new Error("รายการนี้ถูกยกเลิกไปแล้ว");
    if (["RETURNED", "CLAIMED"].indexOf(r.status) !== -1) {
        throw new Error("รายการนี้ปิดงานแล้ว (" + statusThai(r.status) + ") ยกเลิกไม่ได้ ถ้าบันทึกผิดให้บันทึกรายการปรับยอดแทน");
    }
    const inv = readInventory(sh.inv);
    const items = parseItems(r.item, r.typeLabel);
    const touched = [];
    // ทิศทาง NONE (เคลมรอของเข้า) ยังไม่เคยแตะสต็อก → ไม่ต้องคืนอะไร
    if (r.direction === "IN" || r.direction === "OUT") {
        const sign = r.direction === "OUT" ? 1 : -1;
        items.forEach(it => { if (findInv(inv, it)) { adjustStock(sh.inv, inv, it, sign * it.qty); touched.push(invKey(it)); } });
    }
    const why = String(reason || "").trim();
    setLogCells(sh.logs, r, { status: "CANCELLED", cancelledAt: new Date(), cancelReason: why });
    return { body: { status: "success" }, line: [
        "🚫 ยกเลิกรายการ", LINE_RULE,
        "ประเภท : " + r.typeLabel, "ลูกค้า : " + r.cust, "บันทึกเมื่อ : " + r.date,
        "เหตุผล : " + (why || "-"), "",
        "รายการ", ...bulletItems(items),
        ...(touched.length ? ["", "สต็อกหลังคืนยอด", ...stockLines(inv, touched)] : ["", "รายการนี้ยังไม่ได้ตัดสต็อก ไม่มีการปรับยอด"]),
        LINE_RULE, "อ้างอิง " + r.id].join("\n") };
}

function editRemark(sh, id, remark) {
    const r = findLog(sh.logs, id);
    setLogCells(sh.logs, r, { remark: String(remark || "") });
    return { body: { status: "success" } };
}

// ----------------------------------------------------------------------
// 7) ข้อมูลหลัก (เซลล์ / ลูกค้า / รุ่นหิน / เกณฑ์ใกล้หมด)
// ----------------------------------------------------------------------
function addMeta(sh, type, name) {
    const v = String(name || "").trim();
    if (!v) throw new Error("กรุณาระบุชื่อ");
    const col = type === "SALE" ? 0 : 1;
    const data = sh.meta.getDataRange().getValues();
    if (data.slice(1).some(r => String(r[col]).trim() === v)) throw new Error("มีชื่อนี้อยู่แล้ว");
    // ใส่ในช่องว่างแรกของคอลัมน์นั้น (ไม่ต่อท้ายแถวสุดท้ายของทั้งชีต)
    let row = data.findIndex((r, i) => i > 0 && !String(r[col]).trim());
    row = row === -1 ? data.length : row;
    sh.meta.getRange(row + 1, col + 1).setValue(v);
    return { body: { status: "success" } };
}
function deleteMeta(sh, type, name) {
    const col = type === "SALE" ? 0 : 1;
    const data = sh.meta.getDataRange().getValues();
    const values = data.slice(1).map(r => r[col]).filter(v => String(v).trim() && String(v) !== String(name));
    // เขียนคอลัมน์ใหม่ทั้งคอลัมน์แบบชิดบน — ไม่เหลือช่องโหว่
    if (data.length > 1) sh.meta.getRange(2, col + 1, data.length - 1, 1).clearContent();
    if (values.length) sh.meta.getRange(2, col + 1, values.length, 1).setValues(values.map(v => [v]));
    return { body: { status: "success" } };
}
function addModel(sh, model, grit) {
    const m = String(model || "").trim(), g = String(grit || "").trim();
    if (!m || !g) throw new Error("กรุณาระบุรุ่นและเบอร์");
    if (/[#,()]/.test(m) || !/^\d+$/.test(g)) throw new Error("ชื่อรุ่นห้ามมีเครื่องหมาย # , ( ) และเบอร์ต้องเป็นตัวเลข");
    if (readInventory(sh.inv).some(r => r.model === m && r.grit === g)) throw new Error("มีรุ่น " + m + " #" + g + " อยู่แล้ว");
    sh.inv.appendRow([m, g, "New", 0, DEFAULT_MIN_STOCK]);
    sh.inv.appendRow([m, g, "Used", 0, ""]);
    return { body: { status: "success" } };
}
function deleteModel(sh, model, grit) {
    const inv = readInventory(sh.inv);
    const rows = inv.filter(r => r.model === String(model) && r.grit === String(grit));
    if (rows.some(r => r.qty !== 0)) throw new Error("ยังมีสต็อกคงเหลือในรุ่นนี้ ลบได้เมื่อยอดเป็น 0 เท่านั้น");
    rows.map(r => r.row).sort((a, b) => b - a).forEach(row => sh.inv.deleteRow(row));
    return { body: { status: "success" } };
}
function setMinStock(sh, model, grit, minStock) {
    const n = Number(minStock);
    if (!(n >= 0)) throw new Error("เกณฑ์ใกล้หมดต้องเป็นตัวเลข 0 ขึ้นไป");
    const inv = readInventory(sh.inv);
    const row = inv.find(r => r.model === String(model) && r.grit === String(grit) && r.condition === "New");
    if (!row) throw new Error("ไม่พบรุ่นนี้");
    sh.inv.getRange(row.row, 5).setValue(Math.round(n));
    return { body: { status: "success" } };
}

// ======================================================================
// Admin — ตรวจรหัส แล้วออกบัตรผ่าน (token) อายุ 8 ชม. ที่ Server ตรวจได้ทุกคำสั่ง
// ======================================================================
function adminLogin(password) {
    const stored = PropertiesService.getScriptProperties().getProperty("ADMIN_PASSWORD");
    if (stored && String(password) === stored) {
        const expires = Date.now() + ADMIN_TOKEN_HOURS * 3600 * 1000;
        return ok({ token: expires + "." + signToken(String(expires)), expires: expires });
    }
    Utilities.sleep(1200); // ชะลอการเดารหัส
    return fail("รหัสผ่านไม่ถูกต้อง");
}
function signToken(payload) {
    const props = PropertiesService.getScriptProperties();
    let secret = props.getProperty("ADMIN_TOKEN_SECRET");
    if (!secret) { secret = Utilities.getUuid() + Utilities.getUuid(); props.setProperty("ADMIN_TOKEN_SECRET", secret); }
    const sig = Utilities.computeHmacSha256Signature(payload, secret);
    return Utilities.base64EncodeWebSafe(sig).replace(/=+$/, "");
}
function verifyAdminToken(token) {
    if (!token || typeof token !== "string" || token.indexOf(".") === -1) return false;
    const parts = token.split(".");
    const expires = Number(parts[0]);
    if (!(expires > Date.now())) return false;
    return signToken(parts[0]) === parts[1];
}
/** เปลี่ยนรหัส Admin: แก้ค่าแล้วกด Run ครั้งเดียว จากนั้นลบรหัสออกจากโค้ด (บัตรผ่านเดิมทุกใบจะใช้ไม่ได้ทันที) */
function setAdminPassword() {
    const newPassword = "เปลี่ยนรหัสผ่านตรงนี้";
    if (newPassword === "เปลี่ยนรหัสผ่านตรงนี้") throw new Error("กรุณาแก้ค่า newPassword ก่อนกด Run");
    const props = PropertiesService.getScriptProperties();
    props.setProperty("ADMIN_PASSWORD", newPassword);
    props.deleteProperty("ADMIN_TOKEN_SECRET");
    Logger.log("ตั้งรหัสผ่าน Admin ใหม่เรียบร้อยแล้ว — อย่าลืมลบรหัสออกจากโค้ด");
}

// ======================================================================
// สรุปตัวเลข (คำนวณจากทุกแถว ไม่ใช่แค่ประวัติล่าสุด)
// ======================================================================
function buildSummary(rows, inventory, now) {
    const live = rows.filter(r => r.status !== "CANCELLED");
    const startMonth = new Date(now.getFullYear(), now.getMonth(), 1);
    const startPrevMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
    const startYear = new Date(now.getFullYear(), 0, 1);
    const today0 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const d28 = addDays(today0, -27);

    const sales = live.filter(r => r.typeLabel === TYPE_SALE).map(r => ({ r, d: saleDate(r), items: parseItems(r.item, r.typeLabel) }))
        .filter(x => x.d);
    const sumQ = arr => arr.reduce((s, x) => s + Number(x.r.qty || 0), 0);
    const inRange = (d, a, b) => d >= a && d < b;

    const totals = {
        sale: sumQ(sales),
        trial: live.filter(r => r.typeLabel === TYPE_TRIAL).reduce((s, r) => s + Number(r.qty || 0), 0),
        claim: live.filter(r => String(r.typeLabel).indexOf(TYPE_CLAIM) === 0 && r.typeLabel !== TYPE_CLAIM_LEGACY_DUP)
            .reduce((s, r) => s + Number(r.qty || 0), 0)
    };
    const month = {
        thisMonth: sumQ(sales.filter(x => x.d >= startMonth)),
        lastMonth: sumQ(sales.filter(x => inRange(x.d, startPrevMonth, startMonth))),
        thisYear: sumQ(sales.filter(x => x.d >= startYear))
    };

    const daily14 = [];
    for (let i = 13; i >= 0; i--) {
        const a = addDays(today0, -i), b = addDays(a, 1);
        daily14.push({ label: a.getDate() + "/" + (a.getMonth() + 1), qty: sumQ(sales.filter(x => inRange(x.d, a, b))) });
    }

    const bySale = {}, byCustYear = {}, byModelYear = {}, rate28 = {};
    sales.forEach(x => {
        if (x.d >= startMonth) bySale[x.r.sale || "ไม่ระบุ"] = (bySale[x.r.sale || "ไม่ระบุ"] || 0) + Number(x.r.qty || 0);
        if (x.d >= startYear) {
            byCustYear[x.r.cust] = (byCustYear[x.r.cust] || 0) + Number(x.r.qty || 0);
            x.items.forEach(it => { const k = it.model + " #" + it.grit; byModelYear[k] = (byModelYear[k] || 0) + it.qty; });
        }
        if (x.d >= d28) x.items.forEach(it => { const k = it.model + " #" + it.grit; rate28[k] = (rate28[k] || 0) + it.qty; });
    });
    const sortDesc = o => Object.keys(o).map(k => [k, o[k]]).sort((a, b) => b[1] - a[1]);
    Object.keys(rate28).forEach(k => { rate28[k] = Math.round(rate28[k] / 4 * 10) / 10; }); // ก้อน/สัปดาห์

    const open = live.filter(r => ["PENDING", "WAITING_CLAIM", "WAITING_STOCK"].indexOf(r.status) !== -1)
        .map(r => Object.assign(logRowToObject(r), { days: daysBetween(rowDate(r), now) }))
        .sort((a, b) => (b.days || 0) - (a.days || 0));

    const stock = stockGroups(inventory).map(g => Object.assign(g, {
        weeklyRate: rate28[g.key] || 0,
        weeksLeft: rate28[g.key] ? Math.round(g.newQty / rate28[g.key] * 10) / 10 : null,
        low: g.newQty <= g.minStock
    }));

    return {
        generatedAt: now.toISOString(),
        totals, month, daily14,
        week: weekSummary(sales, live, now),
        bySaleMonth: sortDesc(bySale),
        topCustomersYear: sortDesc(byCustYear).slice(0, 5),
        topModelsYear: sortDesc(byModelYear).slice(0, 5),
        stock, open,
        stockTotal: stock.reduce((s, g) => ({ n: s.n + g.newQty, u: s.u + g.usedQty }), { n: 0, u: 0 })
    };
}

/** สรุปสัปดาห์ที่แล้ว (จันทร์–อาทิตย์) เทียบกับสัปดาห์ก่อนหน้า */
function weekSummary(sales, live, now) {
    const today0 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const dow = (today0.getDay() + 6) % 7;            // จันทร์ = 0
    const thisMon = addDays(today0, -dow);
    const from = addDays(thisMon, -7), to = thisMon;  // สัปดาห์ที่แล้ว
    const prevFrom = addDays(from, -7);
    const inR = (d, a, b) => d && d >= a && d < b;
    const q = arr => arr.reduce((s, r) => s + Number(r.qty || 0), 0);
    const wkSales = sales.filter(x => inR(x.d, from, to));
    const models = {}, sellers = {};
    wkSales.forEach(x => {
        sellers[x.r.sale || "ไม่ระบุ"] = (sellers[x.r.sale || "ไม่ระบุ"] || 0) + Number(x.r.qty || 0);
        x.items.forEach(it => { const k = it.model + " #" + it.grit; models[k] = (models[k] || 0) + it.qty; });
    });
    const top = o => { const k = Object.keys(o).sort((a, b) => o[b] - o[a])[0]; return k ? [k, o[k]] : null; };
    return {
        from: from.toISOString(), to: addDays(to, -1).toISOString(),
        sale: wkSales.reduce((s, x) => s + Number(x.r.qty || 0), 0),
        salePrev: sales.filter(x => inR(x.d, prevFrom, from)).reduce((s, x) => s + Number(x.r.qty || 0), 0),
        trialSent: q(live.filter(r => isTrialOrigin(r) && inR(rowDate(r), from, to))),
        trialConverted: q(live.filter(r => isConvertedTrial(r) && inR(toDate(r.closedAt), from, to))),
        inQty: q(live.filter(r => r.direction === "IN" && inR(rowDate(r), from, to))),
        claimQty: q(live.filter(r => String(r.typeLabel).indexOf(TYPE_CLAIM) === 0 && r.typeLabel !== TYPE_CLAIM_LEGACY_DUP && inR(rowDate(r), from, to))),
        topModel: top(models), topSale: top(sellers)
    };
}

/** ขายที่มาจากการส่งทดลอง = ปิดการขายทีหลังวันที่บันทึก (ขายตรงจะปิดพร้อมบันทึก) */
function isConvertedTrial(r) {
    const c = toDate(r.closedAt), d = rowDate(r);
    return r.typeLabel === TYPE_SALE && !!c && !!d && c - d > 60000;
}
function isTrialOrigin(r) { return r.typeLabel === TYPE_TRIAL || isConvertedTrial(r); }

/** ส่งสรุปสัปดาห์เข้า LINE — ตั้งให้รันเองทุกจันทร์ 08:00 ด้วย installWeeklyTrigger() */
function sendWeeklySummary() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sh = prepareSheets(ss);
    const s = buildSummary(readLogRows(sh.logs), readInventory(sh.inv), new Date());
    sendLineNotification(weeklySummaryText(s));
}
function weeklySummaryText(s) {
    const w = s.week;
    const pct = w.salePrev > 0 ? Math.round((w.sale - w.salePrev) / w.salePrev * 100) : null;
    const trend = pct === null ? "" : (pct >= 0 ? " (▲ " + pct + "% จากสัปดาห์ก่อน)" : " (▼ " + Math.abs(pct) + "% จากสัปดาห์ก่อน)");
    const overdue = s.open.filter(o => o.status === "PENDING" && o.days > 14);
    const low = s.stock.filter(g => g.low);
    const lines = [
        "📊 สรุปสัปดาห์ RDS",
        thaiShortDate(new Date(w.from)) + " – " + thaiShortDate(new Date(w.to)),
        LINE_RULE,
        "ขาย " + w.sale + " ก้อน" + trend,
        "ส่งทดลอง " + w.trialSent + " ก้อน · ปิดเป็นขาย " + w.trialConverted,
        "รับเข้า " + w.inQty + " ก้อน · เคลม " + w.claimQty + " ก้อน"
    ];
    if (w.topModel || w.topSale) lines.push("");
    if (w.topModel) lines.push("ขายดีสุด : " + w.topModel[0] + " (" + w.topModel[1] + " ก้อน)");
    if (w.topSale) lines.push("เซลล์ยอดสูงสุด : " + w.topSale[0] + " (" + w.topSale[1] + " ก้อน)");
    lines.push("", "คงเหลือในคลัง " + (s.stockTotal.n + s.stockTotal.u) + " ก้อน (New " + s.stockTotal.n + " · Used " + s.stockTotal.u + ")");
    if (overdue.length || low.length) {
        lines.push("", "ต้องติดตาม");
        if (overdue.length) {
            lines.push("• ทดลองเกิน 14 วัน " + overdue.length + " ราย");
            overdue.slice(0, 5).forEach(o => lines.push("  " + o.cust + " " + o.days + " วัน (" + (o.sale || "-") + ")"));
        }
        if (low.length) lines.push("• ใกล้หมด : " + low.map(g => g.key + " (" + g.newQty + ")").join(", "));
    }
    return lines.join("\n");
}
/** รันครั้งเดียวจากเมนู Run — ตั้งเวลาส่งสรุปสัปดาห์ทุกจันทร์ 08:00 (ใช้ Time zone ของโปรเจกต์) */
function installWeeklyTrigger() {
    ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === "sendWeeklySummary").forEach(t => ScriptApp.deleteTrigger(t));
    ScriptApp.newTrigger("sendWeeklySummary").timeBased().onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(8).nearMinute(0).create();
    Logger.log("ตั้งเวลาส่งสรุปสัปดาห์ทุกวันจันทร์ 08:00 แล้ว (Time zone: " + Session.getScriptTimeZone() + ")");
}

// ======================================================================
// ข้อความ LINE (ข้อความธรรมดา — LINE ไม่รองรับ *ตัวหนา* แบบ Markdown)
// ======================================================================
const LINE_RULE = "──────────────";

function msgNewLog(first, prepared, inv, touched, now) {
    const log = first.log;
    const allItems = [].concat.apply([], prepared.map(x => x.items));
    const total = sumQty(allItems);
    let head;
    if (log.typeLabel === TYPE_CLAIM) head = first.direction === "NONE" ? "🛡️ เคลมสินค้า · รอของเข้า" : "🛡️ เคลมสินค้า · เปลี่ยนให้ลูกค้า";
    else if (log.typeLabel === TYPE_TRIAL) head = "🧪 ส่งทดลองใช้งาน";
    else if (first.direction === "IN") head = String(log.typeLabel).indexOf("Used") !== -1 ? "🔄 รับคืน (Used)" : "📥 รับหินใหม่";
    else head = "💰 " + (log.typeLabel || "จ่ายออก");
    const lines = [head + " · " + total + " ก้อน", LINE_RULE,
        "ลูกค้า : " + (log.cust || "-"), "เซลล์ : " + (log.sale || "-"), "เวลา : " + thaiTimeDate(now), "",
        "รายการ", ...bulletItems(allItems)];
    if (touched.length) lines.push("", first.direction === "IN" ? "คงเหลือหลังรับเข้า" : "คงเหลือหลังตัด", ...stockLines(inv, touched));
    if (first.direction === "NONE") lines.push("", "ของหมด — ยังไม่ตัดสต็อก กด ⚡ เคลม เมื่อของเข้าแล้ว");
    if (log.remark) lines.push("", "หมายเหตุ : " + log.remark);
    lines.push(LINE_RULE, "อ้างอิง " + prepared.map(x => x.id).join(", "));
    return lines.join("\n");
}
function bulletItems(items) { return items.map(it => "• " + it.model + " #" + it.grit + " " + it.condition + " × " + it.qty); }
function stockLines(inv, keys) {
    const seen = {};
    return keys.filter(k => !seen[k] && (seen[k] = true)).map(k => {
        const r = inv.find(x => invKey(x) === k);
        if (!r) return null;
        const newRow = inv.find(x => x.model === r.model && x.grit === r.grit && x.condition === "New");
        const min = newRow && newRow.minStock !== "" ? Number(newRow.minStock) : DEFAULT_MIN_STOCK;
        const warn = r.condition === "New" && r.qty <= min ? " ⚠️ ใกล้หมด" : "";
        return "• " + r.model + " #" + r.grit + " " + r.condition + " " + r.qty + " ก้อน" + warn;
    }).filter(Boolean);
}
function sendLineNotification(message) {
    const props = PropertiesService.getScriptProperties();
    const token = props.getProperty("LINE_TOKEN");
    const to = props.getProperty("LINE_TARGET_ID");
    if (!token || !to) { console.warn("ยังไม่ได้ตั้งค่า LINE_TOKEN / LINE_TARGET_ID ใน Script Properties — ข้ามการแจ้ง LINE"); return; }
    try {
        UrlFetchApp.fetch("https://api.line.me/v2/bot/message/push", {
            method: "post", contentType: "application/json", muteHttpExceptions: true,
            headers: { Authorization: "Bearer " + token },
            payload: JSON.stringify({ to: to, messages: [{ type: "text", text: String(message).slice(0, 4900) }] })
        });
    } catch (e) { console.error("ส่ง LINE ไม่สำเร็จ: " + e); }
}

// ======================================================================
// ตัวช่วย — ชีต / สต็อก / วันที่
// ======================================================================
function prepareSheets(ss) {
    return {
        inv: ensureSheet(ss, "Inventory", INV_HEADERS),
        logs: ensureSheet(ss, "Logs", LOG_HEADERS),
        meta: ensureSheet(ss, "Metadata", META_HEADERS)
    };
}
/** สร้างชีตถ้ายังไม่มี และเติมหัวคอลัมน์ใหม่ที่ยังว่างอยู่ (ไม่แตะข้อมูลเดิม) */
function ensureSheet(ss, name, headers) {
    let s = ss.getSheetByName(name);
    if (!s) { s = ss.insertSheet(name); }
    const lastCol = Math.max(s.getLastColumn(), 1);
    const current = s.getRange(1, 1, 1, Math.max(lastCol, headers.length)).getValues()[0];
    const missing = headers.some((h, i) => !String(current[i] || "").trim());
    if (missing) s.getRange(1, 1, 1, headers.length).setValues([headers.map((h, i) => String(current[i] || "").trim() || h)]);
    return s;
}
function readInventory(sheet) {
    const v = sheet.getDataRange().getValues();
    return v.slice(1).map((r, i) => ({
        row: i + 2, model: String(r[0]).trim(), grit: String(r[1]).trim(), condition: String(r[2]).trim(),
        qty: Number(r[3]) || 0, minStock: r[4] === "" || r[4] === null || r[4] === undefined ? "" : Number(r[4])
    })).filter(r => r.model);
}
function readLogRows(sheet) {
    const v = sheet.getDataRange().getValues();
    return v.slice(1).map((r, i) => {
        const o = { row: i + 2 };
        Object.keys(C).forEach(k => { o[k] = r[C[k]] === undefined ? "" : r[C[k]]; });
        o.id = String(o.id); o.status = String(o.status); o.typeLabel = String(o.typeLabel); o.direction = String(o.direction);
        o.date = o.date instanceof Date ? thaiStamp(fixBuddhistDate(o.date)) : String(o.date);
        o.qty = Number(o.qty) || 0;
        return o;
    }).filter(o => o.id && o.id !== "undefined");
}
function logRowToObject(r) {
    const iso = v => (v instanceof Date ? v.toISOString() : (v ? String(v) : ""));
    return { id: r.id, date: r.date, direction: r.direction, typeLabel: r.typeLabel, item: String(r.item), sale: String(r.sale),
        cust: String(r.cust), qty: r.qty, status: r.status, remark: String(r.remark || ""),
        createdAt: iso(r.createdAt), closedAt: iso(r.closedAt), cancelledAt: iso(r.cancelledAt), cancelReason: String(r.cancelReason || "") };
}
function findLog(sheet, id) {
    const r = readLogRows(sheet).find(x => x.id === String(id));
    if (!r) throw new Error("ไม่พบรายการนี้ (อาจถูกแก้ไขโดยผู้ใช้อื่น) กรุณารีเฟรช");
    return r;
}
function setLogCells(sheet, r, values) {
    Object.keys(values).forEach(k => sheet.getRange(r.row, C[k] + 1).setValue(values[k]));
}

/** แยกข้อความรายการ "R2 #600 (New) x4, R2 #800 (New) x2" → [{model, grit, condition, qty}] */
function parseItems(itemStr, typeLabel) {
    return String(itemStr || "").split(", ").map(entry => {
        const m = entry.match(/(.+) #(\d+)(?:\s*\((.*?)\))?(?:\s*x(\d+))?/);
        if (!m) return null;
        return { model: m[1].trim(), grit: m[2].trim(),
            condition: m[3] ? m[3].trim() : (String(typeLabel).indexOf("Used") !== -1 ? "Used" : "New"),
            qty: m[4] ? Number(m[4]) : 1 };
    }).filter(Boolean);
}
function itemLabel(it) { return it.model + " #" + it.grit + " " + it.condition; }
function invKey(x) { return x.model + "|" + x.grit + "|" + x.condition; }
function findInv(inv, it) { return inv.find(r => invKey(r) === invKey(it)); }
function sumQty(items) { return items.reduce((s, it) => s + it.qty, 0); }
function adjustStock(sheet, inv, it, delta) {
    const r = findInv(inv, it);
    if (!r) return;
    r.qty = r.qty + delta;
    sheet.getRange(r.row, 4).setValue(r.qty);
}
function stockGroups(inv) {
    const g = {};
    inv.forEach(r => {
        const key = r.model + " #" + r.grit;
        if (!g[key]) g[key] = { key: key, model: r.model, grit: r.grit, newQty: 0, usedQty: 0, minStock: DEFAULT_MIN_STOCK };
        if (r.condition === "New") { g[key].newQty = r.qty; if (r.minStock !== "") g[key].minStock = r.minStock; }
        else g[key].usedQty = r.qty;
    });
    return Object.keys(g).map(k => g[k]);
}
function addCustomerIfNew(metaSheet, name) {
    const data = metaSheet.getDataRange().getValues();
    if (data.slice(1).some(r => String(r[1]).trim() === name)) return;
    let row = data.findIndex((r, i) => i > 0 && !String(r[1]).trim());
    row = row === -1 ? data.length : row;
    metaSheet.getRange(row + 1, 2).setValue(name);
}

// วันที่ — คอลัมน์ date เก็บข้อความแบบเดิม "HH:mm d/M/yyyy(พ.ศ.)" เพื่อให้เข้ากับข้อมูลเก่า
// ส่วนการคำนวณใช้ createdAt / closedAt (เวลาจริงจาก Server) และอ่านจากข้อความเฉพาะแถวเก่าที่ยังไม่มี
function thaiStamp(d) {
    return Utilities.formatDate(d, TZ, "HH:mm") + " " + Number(Utilities.formatDate(d, TZ, "d")) + "/" +
        Number(Utilities.formatDate(d, TZ, "M")) + "/" + (Number(Utilities.formatDate(d, TZ, "yyyy")) + 543);
